--- /tmp/wkpretest/debian-rules-plucky.txt	2026-08-16 22:53:56.210142168 +0000
+++ /tmp/wkpretest/src/debian/rules	2026-08-16 22:56:08.274797100 +0000
@@ -6,19 +6,29 @@
 include /usr/share/dpkg/buildflags.mk
 
 export CCACHE_NOHASHDIR=1
-export CCACHE_DIR=$(CURDIR)/ccache
+# Allow callers (webkitgtk-automation) to point at a persistent cache outside the tree.
+CCACHE_DIR ?= $(CURDIR)/ccache
+export CCACHE_DIR
 
 # soup2 build -> 4.0 API packages
 # soup3 build -> 4.1 API packages
 # gtk4 build  -> 6.0 API packages
 ENABLE_SOUP2=NO
-ENABLE_SOUP3=YES
+ENABLE_SOUP3=NO
 ENABLE_GTK4=YES
 # If YES, build libwebkit2gtk-4.0-doc, libjavascriptcoregtk-4.0-bin and webkit2gtk-driver
 # If NO, build libwebkitgtk-doc, libjavascriptcoregtk-bin and webkitgtk-webdriver
 USE_OLD_PKG_NAMES=NO
 
+# webkitgtk-automation: parallel-install stack (alongside system libwebkitgtk-6.0-4).
+WEBKITGTK_VARIANT_SUFFIX = -webdriver
+EXTRA_CMAKE_ARGUMENTS_GTK4_VARIANT = -DWEBKITGTK_VARIANT_SUFFIX=$(WEBKITGTK_VARIANT_SUFFIX)
+
 EXTRA_DH_ARGUMENTS =
+# webkitgtk-automation: ship libwebkitgtk-6.0 only; keep system jsc/webdriver (4.1).
+EXTRA_DH_ARGUMENTS += -Nlibwebkitgtk-doc -Nlibjavascriptcoregtk-bin -Nwebkitgtk-webdriver \
+    -Nlibjavascriptcoregtk-6.0-1 -Nlibjavascriptcoregtk-6.0-dev \
+    -Ngir1.2-javascriptcoregtk-6.0 -Ngir1.2-webkit-6.0
 EXTRA_CMAKE_ARGUMENTS = -DPORT=GTK \
 	   -DCMAKE_INSTALL_LIBEXECDIR=lib/$(DEB_HOST_MULTIARCH) \
 	   -DCMAKE_C_FLAGS_RELEASE="" \
@@ -60,11 +70,14 @@
 
 # The debug packages produced by webkit are huge and cause problems in
 # most buildds. Use -g1 in all architectures to make them smaller.
-CFLAGS := $(CFLAGS:-g=-g1)
-CXXFLAGS := $(CXXFLAGS:-g=-g1)
+# webkitgtk-automation: skip debug info in objects; pair with DEB_BUILD_OPTIONS=noautodbgsym.
+CFLAGS := $(CFLAGS:-g=-g0)
+CXXFLAGS := $(CXXFLAGS:-g=-g0)
 
 # https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=949621
-LDFLAGS += -Wl,--reduce-memory-overheads
+# webkitgtk-automation: omit BFD-only reduce-memory overheads; use gold.
+LDFLAGS += -fuse-ld=gold
+export LDFLAGS
 
 # Don't build with -gsplit-dwarf (see #1016936)
 EXTRA_CMAKE_ARGUMENTS += -DDEBUG_FISSION=OFF
@@ -204,6 +217,11 @@
 	WEBDRIVER_DEP_PKG = libwebkitgtk-6.0-4
 endif
 
+# WebKit #318171: compile INTERACTIONS into libwebkitgtk-6.0.
+# Installed WebKitWebDriver binary still comes from the system package when soup3 is off.
+ifeq ($(ENABLE_GTK4),YES)
+	ENABLE_WEBDRIVER_GTK4 = -DENABLE_WEBDRIVER=ON
+endif
 # The debhelper files for the soup2, soup3 and gtk4 builds are identical
 # (apart from the API version) so we generate the last two from the first.
 WEBKIT_DH_FILES = \
@@ -270,7 +288,7 @@
 		    -e 's/@WK_API_VERSION@/4.0/g' \
 		    -e 's/@LIBJSC_PKG@/libjavascriptcoregtk-4.0-18/g' \
 		    -e 's/@WEBKIT@/webkit2/g' \
-		    -e 's/@LIBWEBKITGTK_PKG@/libwebkit2gtk-4.0-37/g' \
+		    -e 's/libwebkitgtk-6.0-webdriver4/libwebkit2gtk-4.0-37/g' \
 		    -e 's/@GTK_VERSION@/3/g' \
 		    -e 's/@SOUP_VERSION@/2/g' \
 		>> debian/control
@@ -279,7 +297,7 @@
 		    -e 's/@WK_API_VERSION@/4.1/g' \
 		    -e 's/@LIBJSC_PKG@/libjavascriptcoregtk-4.1-0/g' \
 		    -e 's/@WEBKIT@/webkit2/g' \
-		    -e 's/@LIBWEBKITGTK_PKG@/libwebkit2gtk-4.1-0/g' \
+		    -e 's/libwebkitgtk-6.0-webdriver4/libwebkit2gtk-4.1-0/g' \
 		    -e 's/@GTK_VERSION@/3/g' \
 		    -e 's/@SOUP_VERSION@/3/g' \
 		>> debian/control
@@ -288,7 +306,7 @@
 		    -e 's/@WK_API_VERSION@/6.0/g' \
 		    -e 's/@LIBJSC_PKG@/libjavascriptcoregtk-6.0-1/g' \
 		    -e 's/@WEBKIT@/webkit/g' \
-		    -e 's/@LIBWEBKITGTK_PKG@/libwebkitgtk-6.0-4/g' \
+		    -e 's/libwebkitgtk-6.0-webdriver4/libwebkitgtk-6.0-4/g' \
 		    -e 's/@GTK_VERSION@/4/g' \
 		    -e 's/@SOUP_VERSION@/3/g' \
 		>> debian/control
@@ -339,7 +357,8 @@
 		dh_auto_build -Bbuild-soup2 $(EXTRA_BUILD_ARGUMENTS)
 	$(SOUP3_BUILD) CCACHE_BASEDIR=$(CURDIR)/build-soup3 \
 		dh_auto_build -Bbuild-soup3 $(EXTRA_BUILD_ARGUMENTS)
-	$(GTK4_BUILD) dh_auto_build -Bbuild-gtk4 $(EXTRA_BUILD_ARGUMENTS)
+	$(GTK4_BUILD) CCACHE_BASEDIR=$(CURDIR)/build-gtk4 \
+		dh_auto_build -Bbuild-gtk4 $(EXTRA_BUILD_ARGUMENTS)
 
 override_dh_auto_install:
 	$(SOUP2_BUILD) dh_auto_install -Bbuild-soup2
@@ -352,7 +371,8 @@
 	$(GTK4_BUILD)  dh_auto_clean -Bbuild-gtk4
 	find Source Tools -type f -name "*.pyc" -exec rm {} \;
 	find Source Tools -depth -type d -name __pycache__ -exec rmdir {} \;
-	rm -rf ccache
+	# Only remove an in-tree cache; leave an external CCACHE_DIR alone.
+	if [ "$(CCACHE_DIR)" = "$(CURDIR)/ccache" ] || [ "$(CCACHE_DIR)" = "ccache" ]; then rm -rf ccache; fi
 
 # Create a dummy doc directory in case the "nodoc" build option is set.
 override_dh_install-indep:
