--- a/debian/rules	2026-08-15 05:59:59.110496665 +0000
+++ b/debian/rules	2026-08-15 05:59:59.138496024 +0000
@@ -5,14 +5,21 @@
 include /usr/share/dpkg/architecture.mk
 include /usr/share/dpkg/buildflags.mk
 
+export CCACHE_NOHASHDIR=1
+# Allow callers (webkitgtk-automation) to point at a persistent cache outside the tree.
+CCACHE_DIR ?= $(CURDIR)/ccache
+export CCACHE_DIR
+
 # gtk3 build -> 4.1 API packages
 # gtk4 build -> 6.0 API packages
-ENABLE_GTK3=YES
+ENABLE_GTK3=NO
 ENABLE_GTK4=YES
 # YES => build libwebkit2gtk-4.0-doc, libjavascriptcoregtk-4.0-bin and webkit2gtk-driver (for trixie)
 BUILD_TRANSITIONAL_PKGS=NO
 
 EXTRA_DH_ARGUMENTS =
+# webkitgtk-automation: ship libwebkitgtk-6.0 only; keep system webkitgtk-webdriver.
+EXTRA_DH_ARGUMENTS += -Nlibwebkitgtk-doc
 EXTRA_CMAKE_ARGUMENTS = -DPORT=GTK \
 	   -DCMAKE_INSTALL_LIBEXECDIR=lib/$(DEB_HOST_MULTIARCH) \
 	   -DCMAKE_C_FLAGS_RELEASE="" \
@@ -70,11 +77,14 @@
 
 # The debug packages produced by webkit are huge and cause problems in
 # most buildds. Use -g1 in all architectures to make them smaller.
-CFLAGS := $(CFLAGS:-g=-g1)
-CXXFLAGS := $(CXXFLAGS:-g=-g1)
+# webkitgtk-automation: skip debug info in objects; pair with DEB_BUILD_OPTIONS=noautodbgsym.
+CFLAGS := $(CFLAGS:-g=-g0)
+CXXFLAGS := $(CXXFLAGS:-g=-g0)
 
 # https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=949621
-LDFLAGS += -Wl,--reduce-memory-overheads
+# webkitgtk-automation: omit BFD-only reduce-memory overheads; use gold.
+LDFLAGS += -fuse-ld=gold
+export LDFLAGS
 
 # https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1104703
 ifneq (,$(filter $(DEB_HOST_ARCH),arm64))
@@ -212,6 +222,12 @@
 			    -e 's/webkit2/webkit/g' \
 			    -e 's/4\.1/6.0/g'
 
+# WebKit #318171: compile INTERACTIONS into libwebkitgtk-6.0.
+# Installed WebKitWebDriver binary still comes from the system package when gtk3 is off.
+ifeq ($(ENABLE_GTK4),YES)
+	ENABLE_WEBDRIVER_GTK4 = -DENABLE_WEBDRIVER=ON
+endif
+
 %:
 	dh $@ --with gir --buildsystem=cmake+ninja $(EXTRA_DH_ARGUMENTS)
 
@@ -253,12 +269,14 @@
 		-DENABLE_DOCUMENTATION=OFF -DUSE_GTK4=OFF \
 		$(EXTRA_CMAKE_ARGUMENTS)
 	$(GTK4_BUILD) dh_auto_configure -Bbuild-gtk4 -- \
-		-DENABLE_DOCUMENTATION=$(BUILD_DOCS) -DENABLE_WEBDRIVER=OFF \
+		-DENABLE_DOCUMENTATION=$(BUILD_DOCS) \
+		$(ENABLE_WEBDRIVER_GTK4) \
 		$(EXTRA_CMAKE_ARGUMENTS)
 
 override_dh_auto_build:
 	$(GTK3_BUILD) dh_auto_build -Bbuild-gtk3
-	$(GTK4_BUILD) dh_auto_build -Bbuild-gtk4
+	$(GTK4_BUILD) CCACHE_BASEDIR=$(CURDIR)/build-gtk4 \
+		dh_auto_build -Bbuild-gtk4
 
 override_dh_auto_install:
 	$(GTK3_BUILD) dh_auto_install -Bbuild-gtk3
@@ -269,6 +287,8 @@
 	$(GTK4_BUILD) dh_auto_clean -Bbuild-gtk4
 	find Source Tools -type f -name "*.pyc" -exec rm {} \;
 	find Source Tools -depth -type d -name __pycache__ -exec rmdir {} \;
+	# Only remove an in-tree cache; leave an external CCACHE_DIR alone.
+	if [ "$(CCACHE_DIR)" = "$(CURDIR)/ccache" ] || [ "$(CCACHE_DIR)" = "ccache" ]; then rm -rf ccache; fi
 
 # Create a dummy doc directory in case the "nodoc" build option is set.
 override_dh_install-indep:
