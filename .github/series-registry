# Ubuntu series → packaging layout and patch file.
# Layouts:
#   soup3-gtk4  — ENABLE_SOUP2/SOUP3/GTK4 toggles (noble, plucky, questing, …)
#   gtk3-gtk4   — ENABLE_GTK3/GTK4 toggles (resolute, …)
# Add a row when a new Ubuntu release diverges; bump pinned-webkit-version too.
noble=soup3-gtk4:enable-webdriver-gtk4-soup3.patch
plucky=soup3-gtk4:enable-webdriver-gtk4-soup3.patch
questing=soup3-gtk4:enable-webdriver-gtk4-soup3.patch
resolute=gtk3-gtk4:enable-webdriver-gtk4.patch
